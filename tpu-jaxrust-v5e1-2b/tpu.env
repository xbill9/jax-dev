# tpu-jaxrust-v5e1-2b — source of truth for this rig. A real environment variable wins over it.
#
# Gemma 4 E2B, the reference bf16 release, with the forward pass written in Rust
# (rust/src/gemma.rs), emitted as StableHLO and run through libtpu's PJRT plugin on one
# TPU v5e chip (16 GB HBM). No JAX in the model path. The parity reference is the Python JAX
# engine of tpu-jax-v5e1-2b, same checkpoint, same chip type.

# --- Model ------------------------------------------------------------------
# No NAMING.md slot 5: the reference release.
MODEL_NAME=google/gemma-4-E2B-it
MODEL_REVISION=4adf15748de9e1a0097b6274cee9c15836c41c37
# The PJRT plugin the engine dlopens. jax[tpu] installs it with libtpu.
PJRT_PLUGIN=/usr/local/lib/python3.13/dist-packages/libtpu/libtpu.so

# --- Hardware -----------------------------------------------------------------
# server.py maps this to runtime v2-alpha-tpuv5-lite, quota metric
# TPUV5sLitepodPerProjectPerZoneForTPUAPI and GCE machine type ct5lp-hightpu-1t.
ACCELERATOR_TYPE=v5litepod-1
TENSOR_PARALLEL_SIZE=1
GOOGLE_CLOUD_ZONE=us-west4-a
GOOGLE_CLOUD_REGION=us-west4
