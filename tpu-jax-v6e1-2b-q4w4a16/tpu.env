# tpu-jax-v6e1-2b-q4w4a16 — source of truth for this rig. A real environment variable wins over it.
#
# Gemma 4 E2B, Google's QAT weights with the trained Q4_0 grid kept exactly, repacked to
# compressed-tensors W4A16 and served text-only by the pure-JAX engine of
# tpu-jax-v6e1-2b-w4a16 on one TPU v6e chip.

# --- Model ------------------------------------------------------------------
# NAMING.md slot 5: q4w4a16. Header-checked against the loader at this revision
# (benchmarks/runs/2026-11-03-header-check/output.txt).
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text
MODEL_REVISION=315aec06cff196fd6479aa2669bf9379b0d0268a
# MODEL_NAME labels the MCP server's config. jax_openai_server.py carries the same id as
# its MODEL_ID default and takes --model; the engine fetches the repo's main.
QUANT_MODE=w4a16

# --- Hardware -----------------------------------------------------------------
ACCELERATOR_TYPE=v6e-1
TENSOR_PARALLEL_SIZE=1
