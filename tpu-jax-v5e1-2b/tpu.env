# tpu-jax-v5e1-2b — source of truth for this rig. A real environment variable wins over it.
#
# The bf16 baseline for the jax-dev 2B rigs: Gemma 4 E2B as Google released it, served
# text-only by the pure-JAX engine of tpu-jax-v6e1-2b-w4a16 on one TPU v5e chip (16 GB HBM).
# Same engine and server.py as tpu-jax-v5e1-2b-q4w4a16; this file and the checkpoint differ.
# ~/gemma4-dev/tpu-jax-v5e1-2b is a separate rig with the same name in the other tree.

# --- Model ------------------------------------------------------------------
# No NAMING.md slot 5: the reference release. Header-checked against the loader at this
# revision (benchmarks/runs/2026-11-03-header-check/output.txt): every projection dense.
MODEL_NAME=google/gemma-4-E2B-it
MODEL_REVISION=4adf15748de9e1a0097b6274cee9c15836c41c37
# jax_openai_server.py carries the same id as its MODEL_ID default and takes --model; the
# engine fetches the repo's main. fp16 is the engine's name for dense matmuls; the
# weights load as bf16.
QUANT_MODE=fp16

# --- Hardware -----------------------------------------------------------------
# server.py maps this to runtime v2-alpha-tpuv5-lite, quota metric
# TPUV5sLitepodPerProjectPerZoneForTPUAPI and GCE machine type ct5lp-hightpu-1t.
ACCELERATOR_TYPE=v5litepod-1
TENSOR_PARALLEL_SIZE=1
# The zone ~/gemma4-dev/tpu-jax-v5e1-2b provisioned its ct5lp-hightpu-1t flex-start VM in.
GOOGLE_CLOUD_ZONE=us-west4-a
GOOGLE_CLOUD_REGION=us-west4
