# tpu-jax-v5e1-2b-q4w4a16 — source of truth for this rig. A real environment variable wins over it.
#
# Gemma 4 E2B, Google's QAT weights with the trained Q4_0 grid kept exactly, repacked to
# compressed-tensors W4A16 and served text-only by the pure-JAX engine of
# tpu-jax-v6e1-2b-w4a16 on one TPU v5e chip (16 GB HBM). Sibling of
# tpu-jax-v6e1-2b-q4w4a16: same engine, checkpoint and server.py; only this file differs.

# --- Model ------------------------------------------------------------------
# NAMING.md slot 5: q4w4a16. Header-checked against the loader at this revision
# (../tpu-jax-v6e1-2b-q4w4a16/benchmarks/runs/2026-11-03-header-check/output.txt).
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text
MODEL_REVISION=315aec06cff196fd6479aa2669bf9379b0d0268a
# MODEL_NAME labels the MCP server's config. jax_openai_server.py carries the same id as
# its MODEL_ID default and takes --model; the engine fetches the repo's main.
QUANT_MODE=w4a16

# --- Hardware -----------------------------------------------------------------
# The Cloud TPU API's spelling. server.py maps it to the queued-resource runtime
# v2-alpha-tpuv5-lite, the quota metric TPUV5sLitepodPerProjectPerZoneForTPUAPI and the
# GCE machine type ct5lp-hightpu-1t.
ACCELERATOR_TYPE=v5litepod-1
TENSOR_PARALLEL_SIZE=1
# The zone ~/gemma4-dev/tpu-jax-v5e1-2b provisioned its ct5lp-hightpu-1t flex-start VM in.
GOOGLE_CLOUD_ZONE=us-west4-a
GOOGLE_CLOUD_REGION=us-west4
